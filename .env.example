# Create a free LiveKit Cloud project and copy the server URL, API key, and API secret here.
# Keep the API secret and studio access code private. Never use NEXT_PUBLIC_ for these values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
LIVEKIT_DEMO_HOST_PIN=choose-a-long-private-studio-code
