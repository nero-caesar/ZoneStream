# Create a LiveKit Cloud project and copy the server URL, API key, and API secret here.
# Keep the API secret private. Never use NEXT_PUBLIC_ for server credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Firebase web app config (safe to expose to the browser; Firebase rules protect data)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-web-push-public-vapid-key

# Cloudflare R2 storage for shared recorded messages.
# Keep all R2 values server-only; never add the NEXT_PUBLIC_ prefix.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_BUCKET_NAME=zonestream-recordings
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Firebase Admin SDK service account (server-only; never use NEXT_PUBLIC_ here)
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account-email
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-key\n-----END PRIVATE KEY-----\n"
FIREBASE_CHURCH_CODE_SECRET=replace-with-a-random-secret-at-least-32-characters

# Private recovery contact for the shared Zonal Church studio password.
# Server-only; keep out of NEXT_PUBLIC_ variables and source control.
ZONAL_AUTH_EMAIL=zonal-studio-login@example.com
ZONAL_RECOVERY_EMAIL=owner-recovery@example.com

# EmailJS sends the approved Zonal Studio password-reset link to ZONAL_RECOVERY_EMAIL.
# Create a template with the variables to_email, app_name, and reset_link.
# Keep the private key server-only.
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_TEMPLATE_ID=your-emailjs-template-id
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_PRIVATE_KEY=your-emailjs-private-key
